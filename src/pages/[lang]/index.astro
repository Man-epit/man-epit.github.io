---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Media from '../../components/Media.astro';
import Scope from '../../components/Scope.astro';
import Icon from '../../components/Icon.astro';
import { DRAFT } from '../../config';
import { L, getProjects, getEvents, getProfile, getExperience, inFileOrder } from '../../lib';
import { UI, LANGS, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = UI[lang];
const profile = await getProfile();
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const events = await getEvents();
const experience = await getExperience();
const skills = await inFileOrder('skills', 'src/content/skills.yaml');
const leadership = await inFileOrder('leadership', 'src/content/leadership.yaml');
const press = await inFileOrder('press', 'src/content/press.yaml');
const cv = profile.cv[lang];
const github = profile.github.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<Base lang={lang} page="home" description={L(profile.pitch, lang)}>
  <section class="hero">
    <div>
      <h1>{profile.name.split(' ')[0]}<br />{profile.name.split(' ').slice(1).join(' ')}</h1>
      <p class="pitch">{L(profile.pitch, lang)}</p>
      <div class="btns">
        <a class="btn primary" href={`/${lang}/projects/`}>{t.seeProjects}</a>
        {(cv || DRAFT) && <a class="btn" href={cv || '#'} download={cv ? '' : undefined}>{t.cv}</a>}
        {(profile.github || DRAFT) && <a class="btn" href={profile.github || '#'} target="_blank" rel="noopener">
          <Icon name="github" />GitHub</a>}
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
      </div>
    </div>
    <div>
      <Scope coords={profile.coords} />
      {(profile.portrait.src || DRAFT) && <div style="margin-top:14px"><Media m={profile.portrait} dir="profile" lang={lang} cls="portrait" sizes="(max-width: 820px) 100vw, 420px" /></div>}
    </div>
  </section>

  <section class="block" id="work" style="padding-top:24px">
    <div class="shead"><h2>{t.selectedWork}</h2><a href={`/${lang}/projects/`}>{t.allProjects(projects.length)}</a></div>
    <div class="feat">{featured.map((p) => <Card p={p.data} lang={lang} />)}</div>
  </section>

  <section class="block" id="experience">
    <div class="shead"><h2>{t.experience}</h2></div>
    <div class="tl">{experience.map(({ data: x }) => (
      <div class="it"><div class="when">{L(x.when, lang)}</div>
        <div><span class:list={['kind', x.type]}>{x.type === 'edu' ? t.edu : t.work}</span>
        <h3>{L(x.org, lang)} <small>· {L(x.role, lang)}</small></h3>
        {x.note && <ul><li set:html={L(x.note, lang)} /></ul>}</div></div>
    ))}</div>
  </section>

  <section class="block" id="events">
    <div class="shead"><h2>{t.hackTitle}</h2><span class="label">{t.entries(events.length)}</span></div>
    <div class="ev">{events.map(({ data: e }) => (
      <a class="evc" href={`/${lang}/events/${e.slug}/`}>
        <Media m={e.media.find((x) => x.type === 'image') ?? { type: 'image', caption: e.name }} dir={`events/${e.slug}`} lang={lang} inLink sizes="96px" />
        <div>
          <div class="top"><span class="award">★ {L(e.result, lang)}</span><span class="label">{L(e.when, lang)}</span></div>
          <h3>{L(e.name, lang)}</h3>
          <div class="label" style="margin-top:2px">{L(e.format, lang)}</div>
        </div>
      </a>
    ))}</div>
  </section>

  <section class="block" id="skills">
    <div class="shead"><h2>{t.skills}</h2></div>
    <div class="skills">{skills.map(({ data: s }) => <div class="sk"><h3>{L(s.group, lang)}</h3><ul>{s.items.map((i) => <li>{i}</li>)}</ul></div>)}</div>
  </section>

  <section class="block" id="about">
    <div class="shead"><h2>{t.beyond}</h2></div>
    <div class="two">
      <div class="panel">
        <div style="display:grid;gap:14px">{leadership.map(({ data: l }) => (
          <div><div class="role"><h3>{L(l.role, lang)}</h3><span class="label">{L(l.when, lang)}</span></div><p>{L(l.text, lang)}</p></div>
        ))}</div>
      </div>
      <div class="panel">
        <h3 style="margin-bottom:14px">{t.press}</h3>
        <ul class="press">{press.map(({ data: p }) => (
          <li><div><a href={p.url} target="_blank" rel="noopener">{L(p.title, lang)}</a><div class="label" style="margin-top:4px">{p.outlet}</div></div><span class="label">{L(p.when, lang)}</span></li>
        ))}</ul>
        {(profile.pressPhoto.src || DRAFT) && <div style="margin-top:16px"><Media m={profile.pressPhoto} dir="profile" lang={lang} sizes="(max-width: 760px) 100vw, 500px" /></div>}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div><h2>{t.contactTitle}</h2><p>{t.contactText}</p></div>
    <div class="rows">
      <div class="crow"><span class="v" id="mail">{profile.email}</span><button type="button" id="copy" data-copy={t.copy} data-copied={t.copied} data-selected={t.selected}>{t.copy}</button></div>
      <div class="crow"><span class="v"><Icon name="linkedin" size={14} /> {profile.linkedin.replace(/^https?:\/\/(www\.)?/, '')}</span><a href={profile.linkedin} target="_blank" rel="noopener">{t.open}</a></div>
      {(github || DRAFT) && <div class="crow"><span class="v"><Icon name="github" size={14} /> {github || 'github.com/[username]'}</span><a href={profile.github || '#'} target="_blank" rel="noopener">{t.open}</a></div>}
    </div>
  </section>
</Base>

<script>
  const b = document.getElementById('copy') as HTMLButtonElement;
  b.addEventListener('click', async () => {
    const mail = document.getElementById('mail')!;
    try {
      await navigator.clipboard.writeText(mail.textContent!);
      b.textContent = b.dataset.copied!;
    } catch {
      const r = document.createRange();
      r.selectNodeContents(mail);
      getSelection()!.removeAllRanges();
      getSelection()!.addRange(r);
      b.textContent = b.dataset.selected!;
    }
    setTimeout(() => (b.textContent = b.dataset.copy!), 1600);
  });
</script>
