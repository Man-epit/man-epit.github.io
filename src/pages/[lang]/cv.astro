---
// CV page: the PDF pages as images (rendered by `npm run media`) and a download button.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { getProfile } from '../../lib';
import { UI, LANGS, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = UI[lang];
const profile = await getProfile();
const cv = profile.cv[lang];
const name = cv.split('/').pop()!.replace(/\.pdf$/, '');
const all = import.meta.glob<ImageMetadata>('/src/content/profile/media/*.webp', { eager: true, import: 'default' });
const pages = Object.entries(all)
  .map(([k, img]) => [Number(k.match(new RegExp(`/${name}-(\\d+)\\.webp$`))?.[1]), img] as const)
  .filter(([n]) => n)
  .sort(([a], [b]) => a - b);
---
<Base lang={lang} title="CV">
  <div class="crumb"><a href={`/${lang}/`}>← {t.home}</a></div>
  <div class="phead cvhead">
    <h1>CV</h1>
    {cv && <div class="btns">
      <a class="btn primary" href={cv} download>{t.cv}</a>
      <a class="btn" href={cv} target="_blank" rel="noopener">{t.openPdf}</a>
    </div>}
  </div>
  {pages.map(([n, img]) => (
    <Picture src={img} alt={`CV ${profile.name}, page ${n}`} formats={['avif', 'webp']} widths={[600, 1000, 1654]} sizes="(max-width: 860px) 100vw, 820px" class="cvpage" />
  ))}
  <div style="height:48px"></div>
</Base>
