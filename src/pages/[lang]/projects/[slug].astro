---
import Base from '../../../layouts/Base.astro';
import Detail from '../../../components/Detail.astro';
import { L, getProjects, catLabel, resolveRelated } from '../../../lib';
import { UI, LANGS, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const projects = await getProjects();
  return LANGS.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.data.slug }, props: { projects } })));
}
const lang = Astro.params.lang as Lang;
const { projects } = Astro.props;
const t = UI[lang];
const p = projects.find((x) => x.data.slug === Astro.params.slug)!.data;
const related = resolveRelated(p.related, projects, p.slug).map((r) => r.data);
---
<Base lang={lang} page="projects" title={L(p.title, lang)} description={L(p.summary, lang) || undefined}>
  <Detail p={p} lang={lang} base="projects" list={projects.map((x) => x.data)} back={[`/${lang}/projects/`, t.back]}
    meta={[catLabel(p.category, lang), p.year].filter(Boolean).join(' · ')}
    specs={[[t.role, L(p.role, lang)], [t.team, L(p.team, lang)], [t.ctx, L(p.context, lang)], [t.status, t.st[p.status]]]}
    related={related} />
</Base>
